<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (Android 12+; pre-12 devices use backup_rules.xml
  — keep both files in step). Excluded for BOTH cloud backup and
  device-to-device migration, since same-platform migration is the one
  variant that could carry the Android Keystore wrapping from
  flutter_secure_storage along with the data:
  - the encrypted database (drift/SQLite) plus its journal files, stored
    under the app's app_flutter/ documents directory;
  - the flutter_secure_storage preferences files (data values and the
    Keystore-wrapped keys) — the key is device-bound by design (ADR-005);
    a migration that took the key along would undermine exactly that.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="app_flutter/" />
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage.xml" />
        <exclude
            domain="sharedpref"
            path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="app_flutter/" />
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage.xml" />
        <exclude
            domain="sharedpref"
            path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
